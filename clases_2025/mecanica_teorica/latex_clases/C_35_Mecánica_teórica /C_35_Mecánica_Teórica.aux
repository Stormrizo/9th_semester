\@writefile{toc}{\contentsline {section}{\numberline {1}Clase 35: Formulación Hamiltoniana}{2}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Representación esquemática de la construcción de la función Hamiltoniana a partir de la Lagrangiana \(L(q_i, \dot  {q}_i, t)\). Se definen los momentos generalizados \(p_i = \frac  {\partial L}{\partial \dot  {q}_i}\), y se realiza la transformación de Legendre que conduce a \(H(q_i, p_i, t) = \DOTSB \sum@ \slimits@ _{i=1}^{n} p_i \dot  {q}_i - L(q_i, \dot  {q}_i)\).}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:hamiltoniana_transformacion}{{1}{2}{Representación esquemática de la construcción de la función Hamiltoniana a partir de la Lagrangiana \(L(q_i, \dot {q}_i, t)\). Se definen los momentos generalizados \(p_i = \frac {\partial L}{\partial \dot {q}_i}\), y se realiza la transformación de Legendre que conduce a \(H(q_i, p_i, t) = \sum _{i=1}^{n} p_i \dot {q}_i - L(q_i, \dot {q}_i)\)}{figure.caption.2}{}}
