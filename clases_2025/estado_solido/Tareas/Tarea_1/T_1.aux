\@writefile{toc}{\contentsline {section}{\textcolor {Tarawera}{\textbf  {Problemas: cap 3}}}{1}{section*.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Estructura cúbica simple (SC).} Los centros atómicos ocupan las 8 esquinas del cubo. En esta estructura, las esferas vecinas se tocan únicamente a lo largo de la arista: si consideramos dos esquinas adyacentes, la distancia entre sus centros es igual a la longitud de la arista \(a\), y el contacto implica que esa distancia coincide con el diámetro atómico \(2r\); de ahí que \(a=2r\). Cada átomo ubicado en una esquina está compartido por 8 celdas adyacentes, por lo que cada una de ellas sólo contiene una fracción \(1/8\) de ese átomo. Al sumar todas las contribuciones, el número \textbf  {efectivo de átomos por celda unitaria} es \(N_{\text  {ef}}=8\times \tfrac  {1}{8}=1\). Este valor indica que, aunque hay ocho posiciones de red en las esquinas, el contenido real equivalente dentro de una celda cúbica simple corresponde a un solo átomo}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:sc}{{1}{1}{\textbf {Estructura cúbica simple (SC).} Los centros atómicos ocupan las 8 esquinas del cubo. En esta estructura, las esferas vecinas se tocan únicamente a lo largo de la arista: si consideramos dos esquinas adyacentes, la distancia entre sus centros es igual a la longitud de la arista \(a\), y el contacto implica que esa distancia coincide con el diámetro atómico \(2r\); de ahí que \(a=2r\). Cada átomo ubicado en una esquina está compartido por 8 celdas adyacentes, por lo que cada una de ellas sólo contiene una fracción \(1/8\) de ese átomo. Al sumar todas las contribuciones, el número \textbf {efectivo de átomos por celda unitaria} es \(N_{\text {ef}}=8\times \tfrac {1}{8}=1\). Este valor indica que, aunque hay ocho posiciones de red en las esquinas, el contenido real equivalente dentro de una celda cúbica simple corresponde a un solo átomo}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Vista de celda unitaria SC con puntos de red.} Los centros en \((0,0,0)\) y \((a,0,0)\) ilustran un par de esferas vecinas que se tocan sobre la arista \(\overline  {AB}\). La distancia entre centros es \(\lvert (a,0,0)-(0,0,0)\rvert =a\), que debe coincidir con el diámetro \(2r\). Esta observación fija la relación \(a=2r\)}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:uc}{{2}{2}{\textbf {Vista de celda unitaria SC con puntos de red.} Los centros en \((0,0,0)\) y \((a,0,0)\) ilustran un par de esferas vecinas que se tocan sobre la arista \(\overline {AB}\). La distancia entre centros es \(\lvert (a,0,0)-(0,0,0)\rvert =a\), que debe coincidir con el diámetro \(2r\). Esta observación fija la relación \(a=2r\)}{figure.caption.3}{}}
\newlabel{eq:def-factor}{{1}{2}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.1}{}}
\newlabel{eq:nef-sc}{{2}{2}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.2}{}}
\newlabel{eq:vol-atomos}{{3}{2}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.3}{}}
\newlabel{eq:vol-celda}{{4}{2}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.4}{}}
\newlabel{eq:a2r}{{5}{3}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.5}{}}
\newlabel{eq:eta-paso1}{{6}{3}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.6}{}}
\newlabel{eq:eta-paso2}{{7}{3}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.7}{}}
\newlabel{eq:eta-sc-num}{{8}{3}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.8}{}}
\newlabel{eq:porosidad}{{9}{3}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Celdas cúbicas y número de coordinación.} En la estructura cúbica centrada en el cuerpo (BCC) cada vértice del cubo está ocupado por un átomo, al igual que el centro del cubo. Este último se encuentra completamente contenido dentro de la celda. El número de coordinación de esta red es \(8\), ya que cada átomo del centro está en contacto con los ocho átomos de las esquinas. En la figura se comparan los tres tipos de celdas cúbicas (SC, BCC y FCC) para visualizar sus diferencias de empaquetamiento y contenido atómico}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:bcc-tabla}{{3}{4}{\textbf {Celdas cúbicas y número de coordinación.} En la estructura cúbica centrada en el cuerpo (BCC) cada vértice del cubo está ocupado por un átomo, al igual que el centro del cubo. Este último se encuentra completamente contenido dentro de la celda. El número de coordinación de esta red es \(8\), ya que cada átomo del centro está en contacto con los ocho átomos de las esquinas. En la figura se comparan los tres tipos de celdas cúbicas (SC, BCC y FCC) para visualizar sus diferencias de empaquetamiento y contenido atómico}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Vista tridimensional de la celda BCC.} El átomo central se encuentra completamente dentro de la celda, mientras que los de las esquinas se comparten con ocho celdas vecinas. El contacto entre esferas ocurre a lo largo de la \textit  {diagonal del cuerpo}: al unir el centro de una esquina con el átomo del centro y continuar hasta la esquina opuesta, se forma una diagonal de longitud \(\sqrt  {3}\,a\). En ella caben cuatro radios atómicos, lo que establece la relación geométrica \(a = \tfrac  {4r}{\sqrt  {3}}\)}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:bcc-sistemas}{{4}{5}{\textbf {Vista tridimensional de la celda BCC.} El átomo central se encuentra completamente dentro de la celda, mientras que los de las esquinas se comparten con ocho celdas vecinas. El contacto entre esferas ocurre a lo largo de la \textit {diagonal del cuerpo}: al unir el centro de una esquina con el átomo del centro y continuar hasta la esquina opuesta, se forma una diagonal de longitud \(\sqrt {3}\,a\). En ella caben cuatro radios atómicos, lo que establece la relación geométrica \(a = \tfrac {4r}{\sqrt {3}}\)}{figure.caption.5}{}}
\newlabel{eq:def-factor-bcc}{{10}{5}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.10}{}}
\newlabel{eq:nef-bcc}{{11}{6}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.11}{}}
\newlabel{eq:vol-atomos-bcc}{{12}{6}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.12}{}}
\newlabel{eq:vol-celda-bcc}{{13}{6}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.13}{}}
\newlabel{eq:diag-cuerpo}{{14}{6}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.14}{}}
\newlabel{eq:contacto-bcc}{{15}{6}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.15}{}}
\newlabel{eq:a-r-bcc}{{16}{6}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.16}{}}
\newlabel{eq:eta-bcc-1}{{17}{6}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.17}{}}
\newlabel{eq:eta-bcc-2}{{18}{7}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.18}{}}
\newlabel{eq:eta-bcc-num}{{19}{7}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Estructura cúbica centrada en las caras (FCC).} En esta red, los átomos se localizan en los ocho vértices del cubo y en el centro de cada una de sus seis caras. Los átomos de las esquinas se comparten entre ocho celdas, mientras que los ubicados en las caras son compartidos entre dos. El contacto entre esferas se produce a lo largo de la diagonal de una cara, como se indica en el esquema, lo que lleva a la relación geométrica \(a = 2\sqrt  {2}\,r\)}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:fcc-celda}{{5}{7}{\textbf {Estructura cúbica centrada en las caras (FCC).} En esta red, los átomos se localizan en los ocho vértices del cubo y en el centro de cada una de sus seis caras. Los átomos de las esquinas se comparten entre ocho celdas, mientras que los ubicados en las caras son compartidos entre dos. El contacto entre esferas se produce a lo largo de la diagonal de una cara, como se indica en el esquema, lo que lleva a la relación geométrica \(a = 2\sqrt {2}\,r\)}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Vista de la diagonal de cara en la celda FCC.} Al observar una de las caras del cubo, se identifican tres átomos en contacto directo: uno en cada esquina y otro en el centro de la cara. A lo largo de esa diagonal se alinean cuatro radios atómicos, de manera que \(\sqrt  {2}\,a = 4r\). Esta relación es la base para determinar el parámetro de red en función del radio atómico}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:fcc-contacto}{{6}{8}{\textbf {Vista de la diagonal de cara en la celda FCC.} Al observar una de las caras del cubo, se identifican tres átomos en contacto directo: uno en cada esquina y otro en el centro de la cara. A lo largo de esa diagonal se alinean cuatro radios atómicos, de manera que \(\sqrt {2}\,a = 4r\). Esta relación es la base para determinar el parámetro de red en función del radio atómico}{figure.caption.7}{}}
\newlabel{eq:def-factor-fcc}{{20}{8}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Comparación entre las estructuras cúbicas centradas en las caras (FCC) y centradas en el cuerpo (BCC).} En la red \textbf  {BCC} (a la derecha) los átomos se localizan en las ocho esquinas y en el centro del cubo, donde este último está completamente contenido dentro de la celda y en contacto con los ocho átomos de los vértices a lo largo de la diagonal del cuerpo. En la estructura \textbf  {FCC} (a la izquierda), los átomos también ocupan las ocho esquinas, pero además se ubican en el centro de cada una de las seis caras del cubo, compartiéndose entre dos celdas vecinas. El contacto entre átomos en FCC ocurre a lo largo de las diagonales de las caras, lo que da lugar a un empaquetamiento más compacto (\(\eta _{\text  {FCC}}=0.74\)) en comparación con la estructura BCC (\(\eta _{\text  {BCC}}=0.68\)). Esta diferencia geométrica explica por qué, aunque ambas pertenecen al sistema cúbico, la FCC logra una mayor densidad de empaque.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:fcc-compar}{{7}{9}{\textbf {Comparación entre las estructuras cúbicas centradas en las caras (FCC) y centradas en el cuerpo (BCC).} En la red \textbf {BCC} (a la derecha) los átomos se localizan en las ocho esquinas y en el centro del cubo, donde este último está completamente contenido dentro de la celda y en contacto con los ocho átomos de los vértices a lo largo de la diagonal del cuerpo. En la estructura \textbf {FCC} (a la izquierda), los átomos también ocupan las ocho esquinas, pero además se ubican en el centro de cada una de las seis caras del cubo, compartiéndose entre dos celdas vecinas. El contacto entre átomos en FCC ocurre a lo largo de las diagonales de las caras, lo que da lugar a un empaquetamiento más compacto (\(\eta _{\text {FCC}}=0.74\)) en comparación con la estructura BCC (\(\eta _{\text {BCC}}=0.68\)). Esta diferencia geométrica explica por qué, aunque ambas pertenecen al sistema cúbico, la FCC logra una mayor densidad de empaque}{figure.caption.8}{}}
\newlabel{eq:nef-fcc}{{21}{9}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.21}{}}
\newlabel{eq:vol-atomos-fcc}{{22}{9}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.22}{}}
\newlabel{eq:vol-celda-fcc}{{23}{9}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.23}{}}
\newlabel{eq:contacto-fcc}{{24}{10}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.24}{}}
\newlabel{eq:a-r-fcc}{{25}{10}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.25}{}}
\newlabel{eq:eta-fcc-paso1}{{26}{10}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.26}{}}
\newlabel{eq:eta-fcc-paso2}{{27}{10}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.27}{}}
\newlabel{eq:eta-fcc-num}{{28}{10}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Celda unitaria de la estructura hexagonal compacta (HCP).} A la izquierda se muestra la celda convencional, caracterizada por los parámetros de red \(a\) (distancia basal entre centros de átomos) y \(c\) (altura de la celda). A la derecha se ilustra el apilamiento tridimensional de esferas duras en el patrón \emph  {ABAB...}, donde cada átomo está rodeado por doce vecinos: seis en su mismo plano, tres en la capa superior y tres en la inferior. El contacto entre esferas ocurre tanto en el plano basal como entre capas, generando el empaquetamiento más denso posible. \textit  {Fuente: Callister \& Rethwisch, 5e.}}}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:hcp}{{8}{11}{\textbf {Celda unitaria de la estructura hexagonal compacta (HCP).} A la izquierda se muestra la celda convencional, caracterizada por los parámetros de red \(a\) (distancia basal entre centros de átomos) y \(c\) (altura de la celda). A la derecha se ilustra el apilamiento tridimensional de esferas duras en el patrón \emph {ABAB...}, donde cada átomo está rodeado por doce vecinos: seis en su mismo plano, tres en la capa superior y tres en la inferior. El contacto entre esferas ocurre tanto en el plano basal como entre capas, generando el empaquetamiento más denso posible. \textit {Fuente: Callister \& Rethwisch, 5e.}}{figure.caption.9}{}}
\newlabel{eq:def-factor-hcp}{{29}{11}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.29}{}}
\newlabel{eq:vol-atomos-hcp}{{30}{11}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.30}{}}
\newlabel{eq:vol-celda-hcp}{{31}{11}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.31}{}}
\newlabel{eq:c-en-r}{{32}{12}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.32}{}}
\newlabel{eq:eta-hcp-1}{{33}{12}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.33}{}}
\newlabel{eq:eta-hcp-2}{{34}{12}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.34}{}}
\newlabel{eq:eta-hcp-num}{{35}{12}{\textcolor {Tarawera}{\textbf {Lista de problemas y soluciones}}}{equation.35}{}}
